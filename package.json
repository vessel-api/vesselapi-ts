{
  "name": "vesselapi",
  "version": "2.0.0",
  "description": "TypeScript SDK for the Vessel Tracking API: maritime vessel tracking, port events, emissions, and nautical infrastructure",
  "license": "MIT",
  "author": "VesselAPI",
  "repository": {
    "type": "git",
    "url": "https://github.com/vessel-api/vesselapi-ts.git"
  },
  "homepage": "https://vesselapi.com",
  "bugs": {
    "url": "https://github.com/vessel-api/vesselapi-ts/issues"
  },
  "keywords": [
    "vessel",
    "vesselapi",
    "maritime",
    "shipping",
    "ais",
    "vessel-tracking",
    "port-events",
    "emissions",
    "sdk",
    "api-client"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "SMOKE=1 vitest run tests/smoke.test.ts",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
